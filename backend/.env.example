# Copie este arquivo para .env e preencha os valores
# No Render, configure estas variáveis em Environment > Environment Variables

# String de conexão do PostgreSQL
# No Render: injetada automaticamente ao linkar o banco ao Web Service
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Segredo para assinar os tokens JWT — use uma string longa e aleatória
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# Ambiente (development | production)
NODE_ENV=development
